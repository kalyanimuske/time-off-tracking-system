erDiagram
    policies ||--|{ policy_versions : "rules over time"
    policies ||--o{ policy_assignments : "who is on it"
    policies ||--o{ time_off_requests : "requested against"
    policies ||--o{ balance_transactions : "balance of"
    policy_versions ||--o{ balance_transactions : "accrual made by"
    time_off_requests ||--|{ time_off_request_days : "one row per day"
    time_off_requests ||--o{ time_off_request_events : "status history"
    time_off_requests ||--o{ balance_transactions : "hold / usage"

    policies {
        text id PK
        text company_id
        text name
        enum time_off_type
        bool is_paid
    }
    policy_versions {
        text id PK
        text policy_id FK
        int version_number
        date effective_from
        enum accrual_method
        enum frequency
        numeric rate_amount
        enum rate_unit
        numeric carryover_cap_hours
        numeric max_balance_hours
        bool allow_negative
        numeric max_negative_hours
        jsonb tenure_tiers
    }
    policy_assignments {
        text id PK
        text policy_id FK
        text employee_id
        date start_date
        date end_date
    }
    time_off_requests {
        text id PK
        text employee_id
        text policy_id FK
        enum status
        text reason
        int total_minutes
        text decided_by
        text cancelled_by
        text cancel_reason
    }
    time_off_request_days {
        text request_id FK
        date day
        int minutes
    }
    time_off_request_events {
        text id PK
        text request_id FK
        enum from_status
        enum to_status
        text actor_id
        text note
    }
    balance_transactions {
        text id PK
        text employee_id
        text policy_id FK
        text policy_version_id FK
        int amount_minutes
        enum type
        date effective_date
        text idempotency_key UK
        text source_type
        text source_id
        text note
    }
    company_holidays {
        text id PK
        text company_id
        date day
        text location
    }
    audit_log {
        text id PK
        text entity_type
        text entity_id
        text action
        text actor_id
        jsonb before
        jsonb after
    }
